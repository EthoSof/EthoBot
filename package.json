{
  "name": "tanjiro-bot",
  "version": "2.0.0",
  "description": "Tanjiro Bot Multi-Bot Hub & Executive Dashboard para WhatsApp (Baileys Multi-Instancia, IA Asesor, CRM, Catálogo, Economía y Gacha)",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node --experimental-sqlite --max-old-space-size=1024 src/index.js",
    "dev": "node --experimental-sqlite --max-old-space-size=1024 --watch src/index.js",
    "check": "node scripts/check.js",
    "banner": "node scripts/banner.js",
    "test": "node scripts/test-format.js && node scripts/test-ai-quality.js && node scripts/test-ui.js && node scripts/test-plans.js && node scripts/test-accounts.js && node scripts/test-billing.js && node scripts/test-routes.js && node scripts/test-maintenance.js",
    "smoke": "node scripts/smoke.js",
    "start:termux": "node --experimental-sqlite --max-old-space-size=512 src/index.js",
    "termux:setup": "bash scripts/termux-setup.sh",
    "termux:start": "bash scripts/termux-start.sh",
    "termux:stop": "bash scripts/termux-stop.sh"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "axios": "^1.7.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "pino": "^9.5.0",
    "qrcode": "^1.5.4",
    "wa-sticker-formatter": "^4.4.4",
    "yt-search": "^2.12.1"
  },
  "optionalDependencies": {
    "@img/sharp-libvips-win32-x64": "^1.3.4",
    "@img/sharp-win32-x64": "^0.35.5",
    "ffmpeg-static": "^5.2.0"
  },
  "allowScripts": {
    "@whiskeysockets/baileys": true,
    "ffmpeg-static": true,
    "protobufjs": true,
    "sharp": true
  }
}
